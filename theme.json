{
  "font-body": "'Poppins', sans-serif",
  "font-heading": "'Poppins', sans-serif",
  "font-size-base": "16px",
  "font-weight-heading": "700",
  "color-primary": "#667eea",
  "color-secondary": "#764ba2",
  "color-accent": "#d4af37",
